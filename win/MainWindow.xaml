<Window x:Class="SwftExperiments.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bang &amp; Olufsen · Voice"
        Width="860" Height="600"
        MinWidth="600" MinHeight="440"
        Background="{StaticResource BgBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Window.Resources>

        <!-- ── Orb breathing animation ─────────────────────────────────── -->
        <Storyboard x:Key="Breathe" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="OrbScale"
                Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1.045">
                    <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:4" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="OrbScale"
                Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1.045">
                    <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:4" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ── Speaker card template ───────────────────────────────────── -->
        <DataTemplate x:Key="SpeakerCardTemplate">
            <Border Margin="0,0,0,8"
                    Padding="14"
                    CornerRadius="6"
                    Background="{StaticResource CardBgBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#C4A07A" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Speaker icon -->
                    <Viewbox Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Canvas.Style>
                                <Style TargetType="Canvas">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Canvas.Style>
                            <Polygon Points="11,5 6,9 2,9 2,15 6,15 11,19"
                                     Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                     Fill="Transparent" StrokeLineJoin="Round"/>
                            <Path Data="M15.54,8.46 a5,5 0 0 1 0,7.07"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M19.07,4.93 a10,10 0 0 1 0,14.14"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>

                    <!-- Speaker info -->
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13" FontWeight="Normal"/>
                        <TextBlock Text="{Binding StateDisplay}"
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding TrackDisplay}"
                                   FontSize="11" FontStyle="Italic"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding TrackDisplay,
                                       Converter={StaticResource StringToVisibility}}"/>
                        <TextBlock Text="{Binding BatteryDisplay}"
                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding HasBattery,
                                       Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <!-- Volume -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding VolumeDisplay}"
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding VolumeDisplay,
                                   Converter={StaticResource StringToVisibility}}"/>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ── Separator ─────────────────────────────────────────────── -->
        <Rectangle Grid.Column="1" Fill="#1E1E1E"/>

        <!-- ── Main area: orb + transcript ──────────────────────────── -->
        <Grid Grid.Column="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">

                <!-- Orb -->
                <Grid Width="160" Height="160" HorizontalAlignment="Center">
                    <Ellipse Width="160" Height="160">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.38,0.33" Center="0.38,0.33"
                                                 RadiusX="0.62" RadiusY="0.62">
                                <GradientStop Color="#F4EDE0" Offset="0"/>
                                <GradientStop Color="#C8A07E" Offset="0.42"/>
                                <GradientStop Color="#7A5534" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="OrbScale" CenterX="80" CenterY="80"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="OrbGlow"
                                              Color="#C4A07A" BlurRadius="24"
                                              ShadowDepth="0" Opacity="0.15"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>

                <!-- Transcript -->
                <TextBlock x:Name="TranscriptBlock"
                           FontFamily="Georgia" FontStyle="Italic" FontSize="22"
                           TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="380" Margin="0,32,0,0"
                           Foreground="{StaticResource TextBrush}"
                           Opacity="0"/>

                <!-- Mic status -->
                <TextBlock x:Name="MicStatusBlock"
                           FontSize="11" TextAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,16,0,0" Text="Initialising microphone…"/>

            </StackPanel>
        </Grid>

        <!-- ── Speaker pane ───────────────────────────────────────────── -->
        <Grid Grid.Column="2" Margin="20,24,20,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="S P E A K E R S"
                       FontSize="11" FontWeight="Normal"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0,0,0,16"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SpeakerList"
                              ItemTemplate="{StaticResource SpeakerCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
